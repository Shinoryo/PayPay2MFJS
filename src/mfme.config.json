{
  "profileDir": ".paypay2mf-profile",
  "artifactsDir": "artifacts",
  "urls": {
    "signIn": "https://moneyforward.com/sign_in",
    "manualForm": "https://moneyforward.com/cf"
  },
  "timeoutsMs": {
    "navigation": 30000,
    "action": 10000,
    "submit": 15000
  },
  "selectors": {
    "openManualFormButton": "button.modal-switch[href='#user_asset_act_new']",
    "manualFormModal": "#user_asset_act_new",
    "plusPaymentInput": "input.plus-payment",
    "minusPaymentInput": "input.minus-payment",
    "dateInput": "#updated-at",
    "amountInput": "#appendedPrependedInput",
    "accountSelect": "#user_asset_act_sub_account_id_hash",
    "memoInput": "#js-content-field",
    "submitButton": "#submit-button",
    "submitSuccess": "#alert-area",
    "categoryDropdown": ".btn_l_ctg .v_l_ctg",
    "largeCategoryLink": "a.l_c_name",
    "middleCategoryLink": "a.m_c_name",
    "loginForm": "form[action*='sign_in'], input[type='email'], input[type='password']",
    "plusPaymentInModal": "#user_asset_act_new input.plus-payment",
    "minusPaymentInModal": "#user_asset_act_new input.minus-payment",
    "transferPaymentInModal": "#user_asset_act_new input.transfer-payment",
    "transferFromSelect": "#user_asset_act_sub_account_id_hash_from",
    "transferToSelect": "#user_asset_act_sub_account_id_hash_to"
  },
  "submitErrorSelectors": [
    "#user_asset_act_new .flash_alert",
    "#user_asset_act_new .alert-danger",
    "#user_asset_act_new .alert-error",
    "#user_asset_act_new .errorExplanation",
    "#user_asset_act_new .error-message",
    "#user_asset_act_new .mf-input-error",
    "#user_asset_act_new .formError"
  ]
}
